---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import { projects, categoryLabel, projectCount } from '../data/projects';
import type { Category } from '../data/types';
interface Props { category: Category; }
const { category } = Astro.props;
const list = projects.filter(p => p.category === category);
const ux = category === 'ux-ui';
---
<Base title={`${categoryLabel(category)} work — Ella M Williams`} description={ux ? 'UX/UI design by Ella M Williams: onboarding, shopping and community-sharing journeys, from wireframes to interface decisions.' : 'Retail campaigns, editorial layouts and illustrated print development by Ella M Williams for Mountain Warehouse.'}>
  <section class="category-opening page-width"><a class="back-link" href="/">← All work</a><p class="eyebrow">{ux ? 'Digital interfaces & considered interactions' : 'Campaigns, print & editorial'}</p><h1>{ux ? 'UX/UI' : 'Graphic'}<span> design.</span></h1><div class="category-description"><p>{ux ? 'User journeys and interfaces for saving, shopping and community sharing.' : 'Retail offers, editorial spreads and illustrated prints, designed to work in context.'}</p><p>{ux ? 'From wireframes to detailed screens, these projects show how I organise information, give people choices and refine the next step.' : 'I use hierarchy, imagery and a consistent visual language to connect each idea across formats.'}</p></div></section>
  <section class="category-work page-width" aria-label={`${categoryLabel(category)} projects`}><nav class="discipline-nav" aria-label="Work disciplines"><a href="/">All work</a><a class:list={{current:ux}} aria-current={ux ? 'page' : undefined} href="/ux-ui/">UX/UI <span>{projectCount('ux-ui')}</span></a><a class:list={{current:!ux}} aria-current={!ux ? 'page' : undefined} href="/graphic-design/">Graphic Design <span>{projectCount('graphic-design')}</span></a></nav><div class="project-grid category-grid">{list.map((project, index) => <ProjectCard project={project} index={index} />)}</div></section>
</Base>
