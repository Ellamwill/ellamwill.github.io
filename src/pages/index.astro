---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, projectCount } from '../data/projects';
const order = ['UX-POCKET', 'UX-HERB', 'UX-MW', 'GD05', 'GD03', 'GD02'];
const selected = order.map(id => projects.find(p => p.id === id)!);
---
<Base>
  <div class="work-layout page-width">
    <aside class="work-intro" aria-label="Introduction">
      <p class="eyebrow"><span class="small-star" aria-hidden="true">✳</span> UX/UI designer</p>
      <h1>Ella M<br />Williams<span class="name-stop">.</span></h1>
      <p class="intro-statement">Clear journeys.<br /><span>Thoughtful interfaces.</span></p>
      <p class="intro-description">I’m Ella, an aspiring UX/UI designer with a graphic design background. I work from user flows and wireframes through to interface details.</p>
      <a class="intro-about text-link" href="/about/">A little about me <span aria-hidden="true">↗</span></a>
    </aside>
    <section class="work-gallery" aria-labelledby="all-work-title">
      <div class="gallery-header"><h2 class="eyebrow" id="all-work-title">All work <span>({String(selected.length).padStart(2, '0')})</span></h2><span class="gallery-note">A closer look ↓</span></div>
      <nav class="discipline-nav" aria-label="Work disciplines"><a class="current" href="/" aria-current="page">All work</a><a href="/ux-ui/">UX/UI <span>{projectCount('ux-ui')}</span></a><a href="/graphic-design/">Graphic Design <span>{projectCount('graphic-design')}</span></a></nav>
      <div class="project-grid">{selected.map((project, index) => <ProjectCard project={project} index={index} featured={index === 0} />)}</div>
    </section>
  </div>
</Base>
